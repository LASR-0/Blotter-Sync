# Copy to .env beside compose.yaml and fill in what your tier needs.

# Image tag: 1 follows every 1.x release, 1.0 only 1.0.x fixes, or pin
# an exact version such as 1.0.0. Check the compatibility table before
# moving to a new minor version.
BLOTTER_SYNC_TAG=1

# The LAN port. Prefix an address to limit it, e.g. 127.0.0.1:7458 to
# reach the server only through Caddy or Tailscale.
BLOTTER_SYNC_PORT=7458

# Daily backups kept, and the log level (error, warn, info, debug).
BLOTTER_SYNC_KEEP_BACKUPS=20
BLOTTER_SYNC_LOG=info

# --profile caddy: the domain whose DNS points at this host.
BLOTTER_DOMAIN=

# --profile tailscale: an auth key from the Tailscale admin console
# (Settings → Keys), and the machine name on your tailnet.
TS_AUTHKEY=
TS_HOSTNAME=blotter
